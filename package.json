{
  "name": "makendi-worldwide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:content": "node scripts/content-check.mjs",
    "test:products": "node scripts/product-route-check.mjs",
    "test:links": "node scripts/link-check.mjs",
    "test:security": "node scripts/security-check.mjs",
    "test:a11y": "node scripts/accessibility-check.mjs",
    "test:interactions": "node scripts/interaction-check.mjs",
    "test:motion": "node scripts/motion-check.mjs",
    "test:mobile": "node scripts/mobile-check.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "test:performance": "node scripts/performance-check.mjs",
    "test:bundle": "node scripts/bundle-budget.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "test": "npm run test:content && npm run test:products && npm run test:links && npm run test:motion",
    "test:ci": "npm run lint && npm run test:bundle && npm run test:security && npm test && npm run test:a11y && npm run test:interactions && npm run test:mobile && npm run test:visual && npm run test:performance"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "vite": "^8.2.0"
  }
}
